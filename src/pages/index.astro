---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import Icon from '../components/Icon.astro';
import '../styles/v2.css';
import { contact, faqs, insurers, moments, socials } from '../data/site';

import heroImg from '../assets/photos/hero-mama-hija.jpg';
import antesImg from '../assets/photos/antes-pareja-papeles.jpg';
import duranteImg from '../assets/photos/durante-hospital-manos.jpg';
import renovacionImg from '../assets/photos/renovacion-pareja-mayor.jpg';
import retiroImg from '../assets/photos/retiro-abuela-hija.jpg';
import medicoImg from '../assets/photos/medico-abuelo-bebe.jpg';
import cierreImg from '../assets/photos/cierre-familia-mesa.jpg';

const momentImgs: Record<string, { src: ImageMetadata; alt: string }> = {
  antes: { src: antesImg, alt: 'Pareja revisando documentos juntos en la cocina de su casa' },
  durante: { src: duranteImg, alt: 'Una mano sostiene la de una persona en cama de hospital' },
  renovacion: { src: renovacionImg, alt: 'Pareja de adultos mayores revisando papeles en su sala' },
};

const navV2 = [
  { href: '#acompanamiento', label: 'Acompañamiento' },
  { href: '#servicios', label: 'Servicios' },
  { href: '#victor', label: 'Sobre Víctor' },
  { href: '#preguntas', label: 'Preguntas' },
];

const faqsV2 = faqs.slice(0, 4);
const imgFormats = ['avif', 'webp'] as const;
---
<Base
  title="RB y Asociados · Te acompaño antes, durante y después de contratar"
  description="Víctor Robles te acompaña al elegir tu seguro de gastos médicos mayores o tu plan de retiro, cuando necesitas usarlo y en cada renovación."
>
  <a class="skip" href="#contenido">Saltar al contenido</a>

  <header class="site-header">
    <div class="wrap header-inner">
      <a href="#inicio" class="brand" aria-label="RB y Asociados, inicio"><Logo class="brand-logo" /></a>
      <button class="nav-toggle" aria-expanded="false" aria-controls="menu" aria-label="Abrir menú">
        <Icon name="menu" class="i-open" /><Icon name="close" class="i-close" />
      </button>
      <nav id="menu" class="nav" aria-label="Principal">
        <ul>{navV2.map((n) => <li><a href={n.href}>{n.label}</a></li>)}</ul>
        <a class="btn btn-primary btn-sm" href={contact.whatsapp} target="_blank" rel="noopener">
          <Icon name="whatsapp" size={18} /> Escríbeme
        </a>
      </nav>
    </div>
  </header>

  <main id="contenido">
    <!-- PORTADA -->
    <section id="inicio" class="hero">
      <div class="wrap hero-grid">
        <div class="hero-copy">
          <p class="kicker rise" style="--d:0">Seguros médicos y ahorro para el retiro</p>
          <h1>
            <span class="line"><span class="rise" style="--d:1">Tu seguro,</span></span>
            <span class="line"><span class="rise" style="--d:2">con alguien</span></span>
            <span class="line"><span class="rise accent" style="--d:3">a tu lado.</span></span>
          </h1>
          <p class="hero-lead rise" style="--d:4">
            Te explico antes de contratar, te oriento cuando lo usas y reviso contigo cada renovación.
            Asesoría directa, de persona a persona.
          </p>
          <div class="hero-cta rise" style="--d:5">
            <a class="btn btn-primary" href={contact.whatsapp} target="_blank" rel="noopener">
              <Icon name="whatsapp" size={20} /> Platiquemos por WhatsApp
            </a>
            <a class="btn-text" href="#acompanamiento">Cómo te acompaño <Icon name="arrow" size={18} /></a>
          </div>
        </div>

        <div class="hero-media">
          <div class="hero-photo reveal-clip">
            <Picture src={heroImg} formats={imgFormats} widths={[480, 760, 1100]} sizes="(min-width: 960px) 44vw, 92vw"
              alt="Madre e hija abrazadas, sonriendo" loading="eager" fetchpriority="high" class="cover" />
          </div>
          <div class="hero-note rise" style="--d:6">
            <span class="dot" aria-hidden="true"></span>
            Desde 1984 acompañando familias
          </div>
        </div>
      </div>
    </section>

    <!-- FRASE -->
    <section class="statement" aria-label="Nuestra forma de trabajar">
      <div class="wrap">
        <p class="statement-text" data-reveal>
          Contratar es solo el principio. Lo que importa es <em>quién está contigo</em> cuando lo necesitas.
        </p>
      </div>
    </section>

    <!-- ACOMPAÑAMIENTO -->
    <section id="acompanamiento" class="moments">
      <div class="wrap">
        <header class="head" data-reveal>
          <p class="kicker">Cómo te acompaño</p>
          <h2>Tres momentos en los que estoy contigo</h2>
        </header>

        {moments.map((m, i) => (
          <article class:list={['moment', { flip: i % 2 === 1 }]}>
            <div class="moment-media reveal-clip" data-reveal>
              <Picture src={momentImgs[m.key].src} formats={imgFormats} widths={[480, 800, 1200]}
                sizes="(min-width: 960px) 50vw, 92vw" alt={momentImgs[m.key].alt} class="cover" />
            </div>
            <div class="moment-copy" data-reveal>
              <span class="moment-num" aria-hidden="true">0{i + 1}</span>
              <p class="kicker">{m.kicker}</p>
              <h3>{m.title}</h3>
              <p>{m.text}</p>
              <p class="moment-detail">{m.detail}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- SERVICIOS -->
    <section id="servicios" class="services">
      <div class="wrap">
        <header class="head" data-reveal>
          <p class="kicker">En qué te ayudo</p>
          <h2>Dos decisiones que cambian tu tranquilidad</h2>
        </header>
        <div class="service-grid">
          <a class="service" href={contact.whatsappFor('gastos médicos mayores')} target="_blank" rel="noopener" data-reveal>
            <Picture src={medicoImg} formats={imgFormats} widths={[480, 800]} sizes="(min-width: 860px) 46vw, 92vw"
              alt="Abuelo cargando a su nieto con una sonrisa" class="cover" />
            <div class="service-body">
              <p class="kicker light">Gastos médicos mayores</p>
              <h3>Un seguro médico que entiendes y sabes usar</h3>
              <span class="service-cta">Hablar de mi seguro médico <Icon name="arrow" size={18} /></span>
            </div>
          </a>
          <a class="service" href={contact.whatsappFor('ahorro para el retiro')} target="_blank" rel="noopener" data-reveal style="--d:1">
            <Picture src={retiroImg} formats={imgFormats} widths={[480, 800]} sizes="(min-width: 860px) 46vw, 92vw"
              alt="Mujer mayor y su hija riendo juntas en el jardín" class="cover" />
            <div class="service-body">
              <p class="kicker light">Ahorro para el retiro</p>
              <h3>Un plan de retiro que puedes sostener</h3>
              <span class="service-cta">Hablar de mi retiro <Icon name="arrow" size={18} /></span>
            </div>
          </a>
        </div>
        <p class="also" data-reveal>
          También: <a href={contact.whatsappFor('seguro de vida')} target="_blank" rel="noopener">seguro de vida</a>,
          <a href={contact.whatsappFor('ahorro para la educación')} target="_blank" rel="noopener">ahorro para la educación</a> y
          <a href={contact.whatsappFor('seguros para mi empresa')} target="_blank" rel="noopener">empresas</a>.
        </p>
      </div>
    </section>

    <!-- SOBRE VÍCTOR -->
    <section id="victor" class="victor">
      <div class="wrap victor-grid">
        <figure class="victor-photo" data-reveal>
          <!-- FOTO DE VÍCTOR: reemplazar este bloque por <Picture src={victorImg} ... class="cover" /> -->
          <div class="photo-slot">
            <Logo variant="mark" class="slot-mark" />
            <span>Foto de Víctor</span>
          </div>
        </figure>
        <div class="victor-copy" data-reveal style="--d:1">
          <p class="kicker light">Quién te acompaña</p>
          <h2>Hola, soy Víctor Robles</h2>
          <p class="victor-lead">
            Asesor y socio de RB y Asociados. Te ayudo a entender tus opciones de gastos médicos mayores y a planear
            tu ahorro para el retiro según tus metas y presupuesto. Y cuando toca usar tu seguro, sigo ahí.
          </p>
          <dl class="victor-facts">
            <div><dt>Agente desde</dt><dd>1984</dd></div>
            <div><dt>RB y Asociados</dt><dd>2003</dd></div>
            <div><dt>Asegurados</dt><dd>400+</dd></div>
          </dl>
          <p class="victor-cred">LUTC Fellow (primera generación) · F.S.S. American College e IMESFAC</p>
          <ul class="socials" aria-label="Redes de Víctor">
            {socials.map((s) => (
              <li>
                <a href={s.url || '#'} class:list={{ pending: !s.url }} aria-label={s.name} target={s.url ? '_blank' : undefined} rel="noopener">
                  <Icon name={s.icon} size={20} />
                </a>
              </li>
            ))}
            <li><a href={contact.whatsapp} aria-label="WhatsApp" target="_blank" rel="noopener"><Icon name="whatsapp" size={20} /></a></li>
            <li><a href={`mailto:${contact.email}`} aria-label="Correo"><Icon name="mail" size={20} /></a></li>
          </ul>
        </div>
      </div>
    </section>

    <!-- ASEGURADORAS -->
    <section class="insurers" aria-labelledby="insurers-title">
      <div class="wrap">
        <p id="insurers-title" class="insurers-title" data-reveal>Trabajo con aseguradoras sólidas para encontrar la opción que te conviene</p>
        <ul class="insurer-list" data-reveal>
          {insurers.map((c) => <li>{c.name}</li>)}
        </ul>
      </div>
    </section>

    <!-- PREGUNTAS -->
    <section id="preguntas" class="faq-section">
      <div class="wrap faq-grid">
        <header class="head" data-reveal>
          <p class="kicker">Preguntas frecuentes</p>
          <h2>Lo que más me preguntan</h2>
        </header>
        <div class="faq" data-reveal>
          {faqsV2.map((f) => (
            <details name="faq">
              <summary>{f.q}<Icon name="plus" size={20} class="faq-icon" /></summary>
              <div class="faq-body"><p>{f.a}</p></div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- CIERRE -->
    <section id="contacto" class="closing">
      <Picture src={cierreImg} formats={imgFormats} widths={[800, 1400, 1800]} sizes="100vw"
        alt="" class="closing-bg" />
      <div class="wrap closing-inner" data-reveal>
        <h2>¿Platicamos?</h2>
        <p>Cuéntame qué te interesa y si tienes o has tenido un seguro. Con eso empezamos.</p>
        <div class="closing-cta">
          <a class="btn btn-primary" href={contact.whatsapp} target="_blank" rel="noopener">
            <Icon name="whatsapp" size={20} /> {contact.phoneDisplay}
          </a>
          <a class="btn btn-outline-light" href={`mailto:${contact.email}`}>
            <Icon name="mail" size={20} /> {contact.email}
          </a>
        </div>
        <p class="closing-cities"><Icon name="pin" size={16} /> {contact.cities.join(' · ')}</p>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="wrap footer-inner">
      <Logo tone="light" class="footer-logo" />
      <p>© {new Date().getFullYear()} RB y Asociados. La emisión de pólizas y la resolución de reembolsos corresponden a cada aseguradora conforme a las condiciones de la póliza.</p>
    </div>
  </footer>

  <a class="wa-float" href={contact.whatsapp} target="_blank" rel="noopener" aria-label="Escribir a Víctor por WhatsApp">
    <Icon name="whatsapp" size={26} />
  </a>
</Base>
