---
import { langs, langPath, type Lang } from '../i18n/content';
interface Props { lang: Lang; label: string }
const { lang, label } = Astro.props;
const names: Record<Lang, string> = { es: 'Español', en: 'English' };
---
<div class="lang-switch" role="group" aria-label={label}>
  {langs.map((l) => (
    <a
      href={langPath[l]}
      hreflang={l}
      lang={l}
      data-lang={l}
      aria-label={names[l]}
      aria-current={l === lang ? 'true' : undefined}
      class:list={{ active: l === lang }}
    >{l.toUpperCase()}</a>
  ))}
  <span class="lang-pill" aria-hidden="true"></span>
</div>
